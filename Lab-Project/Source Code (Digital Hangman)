// ============================================================
//  DIGITAL HANGMAN — 16x2 LCD Optimized Version
//  Hardware : Arduino + 16x2 I2C LCD + Buzzer + Reset Button
// ============================================================
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// Set for 16 columns and 2 rows
LiquidCrystal_I2C lcd(0x27, 16, 2); 

// ── Pin config ───────────────────────────────────────────────
const int buzzerPin       = 8;
const int resetButtonPin  = 7;

// ── Word pool ────────────────────────────────────────────────
const int WORD_COUNT = 10;
const String wordPool[WORD_COUNT] = {
  "SPHINX", "QUARTZ", "EGYPT", "PIXEL", "RHYTHM",
  "ACE", "ABACUS", "CRYPTO", "KNIGHT", "ANCHOR"
};

// ── Game state ───────────────────────────────────────────────
String secretWord     = "";
String guessed         = "";
String guessedLetters = ""; 
int    attempts       = 6;  
bool   gameOver       = false;

// ── Scoring ──────────────────────────────────────────────────
int  score      = 100;
int  highScore  = 0;
int  deductPer  = 10;

// ── Timer ────────────────────────────────────────────────────
const unsigned long TURN_LIMIT_MS = 15000UL;
unsigned long turnStart   = 0;
bool timerRunning         = false;

void setup() {
  Serial.begin(9600);
  lcd.init();
  lcd.backlight();
  pinMode(buzzerPin,      OUTPUT);
  pinMode(resetButtonPin, INPUT_PULLUP);
  randomSeed(analogRead(A0));
  startNewGame();
  showStart();
}

void loop() {
  if (digitalRead(resetButtonPin) == LOW) {
    delay(50);
    if (digitalRead(resetButtonPin) == LOW) {
      resetGame();
      while (digitalRead(resetButtonPin) == LOW);
    }
  }

  if (gameOver) return;

  if (timerRunning) {
    unsigned long elapsed = millis() - turnStart;
    if (elapsed >= TURN_LIMIT_MS) {
      handleTimeout();
      return;
    }
  }

  if (Serial.available() > 0) {
    char guess = toupper((char)Serial.read());
    while (Serial.available() > 0) Serial.read(); 
    if (isAlpha(guess)) {
      processGuess(guess);
    }
  }
}

void startNewGame() {
  int idx    = random(0, WORD_COUNT);
  secretWord = wordPool[idx];
  guessed    = "";
  guessedLetters = "";
  for (int i = 0; i < (int)secretWord.length(); i++) guessed += '_';
  attempts  = 6;
  gameOver  = false;
  score     = 100;
  deductPer = max(5, 60 / (int)secretWord.length());
  startTimer();
}

void processGuess(char guess) {
  if (guessedLetters.indexOf(guess) >= 0) {
    lcd.setCursor(0, 1);
    lcd.print("Already used: ");
    lcd.print(guess);
    tone(buzzerPin, 600, 100);
    delay(800); // Give time to read on small screen
    printStatus();
    return;
  }

  guessedLetters += guess;
  bool correct = false;
  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (secretWord[i] == guess && guessed[i] == '_') {
      guessed[i] = guess;
      correct = true;
    }
  }

  if (correct) {
    tone(buzzerPin, 1200, 150);
  } else {
    attempts--;
    score -= deductPer;
    if (score < 0) score = 0;
    tone(buzzerPin, 300, 300);
  }

  checkGameState();
  if (!gameOver) {
    printStatus();
    startTimer();
  }
}

void handleTimeout() {
  timerRunning = false;
  attempts--; 
  score -= deductPer;
  if (score < 0) score = 0;
  revealHint();
  tone(buzzerPin, 250, 400);
  lcd.clear();
  lcd.print("TIME OUT! +HINT");
  delay(1200);
  checkGameState();
  if (!gameOver) {
    printStatus();
    startTimer();
  }
}

void revealHint() {
  int positions[20];
  int count = 0;
  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (guessed[i] == '_') positions[count++] = i;
  }
  if (count == 0) return;
  int pick   = positions[random(0, count)];
  char hintC = secretWord[pick];
  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (secretWord[i] == hintC) guessed[i] = hintC;
  }
  if (guessedLetters.indexOf(hintC) < 0) guessedLetters += hintC;
}

void checkGameState() {
  if (attempts <= 0) {
    gameOver = true;
    lcd.clear();
    lcd.print("YOU LOSE! ");
    lcd.setCursor(0, 1);
    lcd.print(secretWord);
    lcd.print(" S:"); lcd.print(score);
    loseSound();
  } 
  else if (guessed == secretWord) {
    gameOver = true;
    if (score > highScore) highScore = score;
    lcd.clear();
    lcd.print("WIN! Score:"); lcd.print(score);
    lcd.setCursor(0, 1);
    lcd.print("Best:"); lcd.print(highScore);
    winSound();
  }
}

void printStatus() {
  lcd.clear();
  // Line 0: Word display
  lcd.setCursor(0, 0);
  lcd.print("WORD:"); lcd.print(guessed);
  
  // Line 1: Stats
  lcd.setCursor(0, 1);
  lcd.print("Att:"); lcd.print(attempts);
  lcd.print(" Pts:"); lcd.print(score);

}

void resetGame() {
  while (Serial.available() > 0) Serial.read();
  startNewGame();
  lcd.clear();
  lcd.print("NEW GAME");
  delay(1500);
  printStatus();
}

void showStart() {
  lcd.clear();
  lcd.setCursor(3, 0);
  lcd.print("*DIGITAL*");
  lcd.setCursor(3, 1);
  lcd.print("*HANGMAN*");
  delay(3000);
  printStatus();
}

void startTimer() {
  turnStart    = millis();
  timerRunning = true;
}

void winSound() {
  tone(buzzerPin, 1000, 120); delay(150);
  tone(buzzerPin, 1300, 120); delay(150);
  tone(buzzerPin, 1600, 120); delay(150);
  tone(buzzerPin, 2000, 250);
}

void loseSound() {
  tone(buzzerPin, 400, 300); delay(350);
  tone(buzzerPin, 300, 300); delay(350);
  tone(buzzerPin, 200, 600);
}

bool isAlpha(char c) {
  return (c >= 'A' && c <= 'Z');
}
