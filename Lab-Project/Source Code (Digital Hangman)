// ============================================================
//  DIGITAL HANGMAN  —  Final Hardware Version
//  Hardware : Arduino + 16x2 I2C LCD + Buzzer + Reset Button
// ============================================================
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
LiquidCrystal_I2C lcd(0x27, 20, 4);

// ── Pin config ───────────────────────────────────────────────
const int buzzerPin       = 8;
const int resetButtonPin  = 2;

// ── Word pool ────────────────────────────────────────────────
const int WORD_COUNT = 10;
const String wordPool[WORD_COUNT] = {
  "SPHINX", "QUARTZ", "EGYPT", "PIXEL", "RHYTHM",
  "ACE", "ABACUS", "CRYPTO", "KNIGHT", "ANCHOR"
};

// ── Game state ───────────────────────────────────────────────
String secretWord     = "";
String guessed         = "";
String guessedLetters = ""; 
int    attempts       = 6;  
bool   gameOver       = false;

// ── Scoring ──────────────────────────────────────────────────
int  score      = 100;
int  highScore  = 0;
int  deductPer  = 10;

// ── Timer ────────────────────────────────────────────────────
const unsigned long TURN_LIMIT_MS = 15000UL;
unsigned long turnStart  = 0;
bool timerRunning        = false;

// ────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(9600);
  lcd.init();
  lcd.backlight();
  pinMode(buzzerPin,      OUTPUT);
  pinMode(resetButtonPin, INPUT_PULLUP);
  randomSeed(analogRead(A0));
  startNewGame();
  showStart();
}

// ────────────────────────────────────────────────────────────
void loop() {
  // Reset button
  if (digitalRead(resetButtonPin) == LOW) {
    delay(50);
    if (digitalRead(resetButtonPin) == LOW) {
      resetGame();
      while (digitalRead(resetButtonPin) == LOW);
    }
  }

  if (gameOver) return;

  // Timer countdown
  if (timerRunning) {
    unsigned long elapsed = millis() - turnStart;
    if (elapsed >= TURN_LIMIT_MS) {
      handleTimeout();
      return;
    }
    int secsLeft = (int)((TURN_LIMIT_MS - elapsed) / 1000UL) + 1;
    lcd.setCursor(0, 3);
    lcd.print("Time: ");
    if (secsLeft < 10) lcd.print(" ");
    lcd.print(secsLeft);
    lcd.print("s   ");
  }

  // Serial input
  if (Serial.available() > 0) {
    char guess = toupper((char)Serial.read());
    while (Serial.available() > 0) Serial.read(); 
    if (isAlpha(guess)) {
      processGuess(guess);
    }
  }
}

void startNewGame() {
  int idx    = random(0, WORD_COUNT);
  secretWord = wordPool[idx];

  guessed        = "";
  guessedLetters = "";
  for (int i = 0; i < (int)secretWord.length(); i++) guessed += '_';

  attempts  = 6;
  gameOver  = false;
  score     = 100;
  deductPer = max(5, 60 / (int)secretWord.length());

  startTimer();
}

void processGuess(char guess) {
  if (guessedLetters.indexOf(guess) >= 0) {
    lcd.setCursor(0, 2);
    lcd.print("Already tried: ");
    lcd.print(guess);
    lcd.print("  ");
    tone(buzzerPin, 600, 100);
    return;
  }

  guessedLetters += guess;

  bool correct = false;
  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (secretWord[i] == guess && guessed[i] == '_') {
      guessed[i] = guess;
      correct = true;
    }
  }

  if (correct) {
    tone(buzzerPin, 1200, 150);
  } else {
    attempts--;
    score -= deductPer;
    if (score < 0) score = 0;
    tone(buzzerPin, 300, 300);
  }

  delay(350);
  checkGameState();
  if (!gameOver) {
    printStatus();
    startTimer();
  }
}

void handleTimeout() {
  timerRunning = false;
  attempts--; 
  score -= deductPer;
  if (score < 0) score = 0;

  revealHint();
  tone(buzzerPin, 250, 400);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Time's up! -hint");
  delay(1200);

  checkGameState();
  if (!gameOver) {
    printStatus();
    startTimer();
  }
}

void revealHint() {
  int positions[20];
  int count = 0;
  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (guessed[i] == '_') positions[count++] = i;
  }
  if (count == 0) return;

  int pick   = positions[random(0, count)];
  char hintC = secretWord[pick];

  for (int i = 0; i < (int)secretWord.length(); i++) {
    if (secretWord[i] == hintC) guessed[i] = hintC;
  }
  if (guessedLetters.indexOf(hintC) < 0) guessedLetters += hintC;
}

// ── FIXED Game State Logic ──────────────────────────────────
void checkGameState() {
  // Check Lose Condition FIRST
  if (attempts <= 0) {
    gameOver = true;
    lcd.clear();
    lcd.setCursor(4, 0);
    lcd.print("YOU LOSE!");
    lcd.setCursor(0, 1);
    lcd.print("Ans: "); lcd.print(secretWord);
    lcd.setCursor(0, 2);
    lcd.print("Score: "); lcd.print(score);
    lcd.setCursor(0, 3);
    lcd.print("Best:  "); lcd.print(highScore);
    loseSound(); // This triggers the losing buzzer melody
  } 
  // Check Win Condition SECOND
  else if (guessed == secretWord) {
    gameOver = true;
    if (score > highScore) highScore = score;
    lcd.clear();
    lcd.setCursor(1, 0);
    lcd.print("** YOU WIN! **");
    lcd.setCursor(0, 1);
    lcd.print("Word:"); lcd.print(secretWord);
    lcd.setCursor(0, 2);
    lcd.print("Score: "); lcd.print(score);
    lcd.setCursor(0, 3);
    lcd.print("Best:  "); lcd.print(highScore);
    winSound();
  }
}

void printStatus() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Word: ");
  lcd.print(guessed);
  lcd.setCursor(0, 1);
  lcd.print("Att:"); lcd.print(attempts);
  lcd.print("  Pts:"); lcd.print(score);
  lcd.setCursor(0, 2);
  lcd.print("Tried:");
  lcd.print(guessedLetters);
  lcd.setCursor(0, 3);
  lcd.print("Time: 15s   ");
}

void resetGame() {
  while (Serial.available() > 0) Serial.read();
  startNewGame();
  lcd.clear();
  lcd.setCursor(4, 0);
  lcd.print("NEW GAME!");
  lcd.setCursor(4, 1);
  lcd.print("Best: "); lcd.print(highScore);
  delay(1200);
  printStatus();
}

void showStart() {
  lcd.clear();
  lcd.setCursor(4, 0);
  lcd.print("*DIGITAL");
  lcd.setCursor(5, 1);
  lcd.print("HANGMAN*");
  lcd.setCursor(2, 2);
  lcd.print("Send letter via");
  lcd.setCursor(3, 3);
  lcd.print("Serial Monitor");
  delay(4000);
  printStatus();
}

void startTimer() {
  turnStart    = millis();
  timerRunning = true;
}

void winSound() {
  tone(buzzerPin, 1000, 120); delay(150);
  tone(buzzerPin, 1300, 120); delay(150);
  tone(buzzerPin, 1600, 120); delay(150);
  tone(buzzerPin, 2000, 250);
}

void loseSound() {
  tone(buzzerPin, 400, 300); delay(350);
  tone(buzzerPin, 300, 300); delay(350);
  tone(buzzerPin, 200, 600);
}

bool isAlpha(char c) {
  return (c >= 'A' && c <= 'Z');
}
